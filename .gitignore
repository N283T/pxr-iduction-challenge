# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# pixi
.pixi/*
!.pixi/config.toml

# PostgreSQL data (local only, re-creatable from db/*.sql + data/)
db/pgdata/

# Data files (re-downloadable via download_data.py / eda_redo_*.py)
data/*.parquet
data/**/*.parquet
data/**/*.h5
data/**/*.db
data/*.bak_*
data/**/*_meta.json
data/eda_redo/
data/eda_cv_prep/
data/chembl/
data/drugclip_embed_smoke/
data/optuna_chemprop_pretrain/

# Submission files (generated artifacts)
track1_activity/submissions/
track2_structure/submissions/

# Boltz-2 pipeline artifacts (re-creatable from DB + AFDB MSA)
structures/boltz2/msa/
structures/boltz2/inputs/
structures/boltz2/inputs_fast/
structures/boltz2/inputs_fast_smoke/
structures/boltz2/outputs/
structures/boltz2/outputs_fast/
structures/boltz2/ligands/
structures/boltz2/manifest*.csv
structures/boltz2/postprocess*.csv
structures/boltz2/posebusters*.csv
structures/boltz2_track2/

# Track 2 input YAMLs are derivable from data/structure_test.parquet via
# build_inputs.py, so we don't track them in git.
track2_structure/inputs/

# GatorAffinity Phase A/B pipeline (re-creatable from compound_boltz2)
structures/gator/

# OpenEye Omega 3D conformer SDFs (~545 MB, regenerable via db/compute_omega.py)
structures/omega/

# Uni-Mol ETKDG pretrain-embed data + checkpoints (regenerable)
data/unimol/
data/unimol_v2_pretrain_embed.parquet
models/unimol_v2_log2fc/
models/unimol_v2_log2fc_seed*/
models/chemprop_mtr_seed*/
models/molformer_c3_mtr_seed*/

# Boltz-2 affinity-head retarget (issue #74) pooled embeddings parquet
data/boltz_affhead/

# multitask_aux tune artifacts (sqlite + raw full stdout; rebuildable
# from 01_importance_lgbm.py + 04_optuna_tune.py). CSVs and 1-line
# trial summaries are kept.
track1_activity/reports/multitask_aux/*.db
track1_activity/reports/multitask_aux/optuna_multitask_desc_5fold_run.log
track1_activity/reports/multitask_aux/run_desc*.log
track1_activity/reports/multitask_aux/run_tabpfn_top2000.log

# ChemProp pretrain checkpoints (regenerable via run_chemprop_pretrain.py
# in ~15 min; meta.json is kept for audit).
track1_activity/checkpoints/chemprop_pretrain/*.pt
track1_activity/checkpoints/chemprop_pretrain/*.ckpt

logs/
track1_activity/reports/*.log

# Raw LiteParse output for external papers (regenerable; md
# summaries are checked in separately under docs/papers/)
docs/papers/*_raw/

# Lightning checkpoints/logs
checkpoints/
lightning_logs/

# Marimo session state
__marimo__/

# Ruff cache
.ruff_cache/

# Editor
.idea/
.vscode/
*.swp

# OS
.DS_Store
.claude/

# Local submission clients can contain personal tokens or account-specific state.
track1_activity/scripts/submit.py
track1_activity/scripts/api.py
track1_activity/mordred_feature_importance.json

# uv lockfile (project uses pixi)
uv.lock

# KERMT pipeline artifacts (weights + CSVs + embed parquet)
models/kermt/*
!models/kermt/README.md
data/kermt/
data/kermt_pretrain_embed.parquet
